#!/bin/sh

set -e

# augment path to help it find cmake installed in /usr/local/bin,
# e.g. via brew. Xcode's Run Script phase doesn't seem to honor
# ~/.MacOSX/environment.plist
if [[ `uname -m` == 'arm64' ]]; then
  echo "** Running on a Apple Silicon M1"
  PATH="/opt/homebrew/bin:$PATH"
else
  echo "** Running on a Apple x86"
  PATH="/usr/local/bin:$PATH"
fi

SCRIPT_DIR=$(dirname "$0")
source "${SCRIPT_DIR}/xcode_functions.sh"

function setup_build_environment ()
{
    pushd "$SCRIPT_DIR/.." > /dev/null
    ROOT_PATH="$PWD"
    popd > /dev/null

    CLANG="/usr/bin/xcrun clang"
    CC="${CLANG}"
    CPP="${CLANG} -E"

    # We need to clear this so that cmake doesn't have a conniption
    MACOSX_DEPLOYMENT_TARGET=""

    XCODE_MAJOR_VERSION=$(xcode_major_version)
    XCODE_MINOR_VERSION=$(xcode_minor_version)

    CAN_BUILD_ARM="0"

    # Determine if we can be building for ARM Macs
    if [ "${XCODE_MAJOR_VERSION}" -ge "13" ]
    then
        CAN_BUILD_ARM="1"
    elif  [ "${XCODE_MAJOR_VERSION}" -eq "12" ] && [ "${XCODE_MINOR_VERSION}" -ge "2" ]
    then
        CAN_BUILD_ARM="1"
    fi

    ARCHS="x86_64"
    if [ "${CAN_BUILD_ARM}" -eq "1" ]
    then
        ARCHS="${ARCHS} arm64 arm64e"
    fi
}

function build_all_archs ()
{
    setup_build_environment

    local setup=$1
    local build_arch=$2
    local finish_build=$3

    # run the prepare function
    eval $setup

    echo "Building for ${ARCHS}"

    for ARCH in ${ARCHS}
    do
        PLATFORM="macosx"
        SDKVERSION=$(macos_sdk_version)

        SDKNAME="${PLATFORM}${SDKVERSION}"
        SDKROOT="$(sdk_path ${SDKNAME})"

        echo "Building ${LIBRARY_NAME} for ${SDKNAME} ${ARCH}"
        echo "Please stand by..."

        # run the per arch build command
        eval $build_arch
    done

    # finish the build (usually lipo)
    eval $finish_build
}

function setup ()
{
    LIBRARY_NAME="libgit2"
    LIB_PATH="${ROOT_PATH}/External/libgit2-mac"
    STAMP="${LIB_PATH}/BUILT_FROM"
    # libgit2 compiles against libssh2's headers, so a libssh2 rebuild
    # (recorded in its stamp) means a libgit2 rebuild too.
    WANTED="libgit2 $(source_rev "${ROOT_PATH}/External/libgit2") $(cat "${ROOT_PATH}/External/libssh2-mac/BUILT_FROM" 2>/dev/null) archs:${ARCHS}"

    if [ -f "${LIB_PATH}/libgit2-mac.a" ] && \
       [ "$(cat "${STAMP}" 2>/dev/null)" == "${WANTED}" ]
    then
        echo "No update needed."
        exit 0
    fi

    rm -rf "${LIB_PATH}"

    pushd "${ROOT_PATH}/External/libgit2" > /dev/null
}

function build_libgit2 ()
{
    rm -rf "build"
    mkdir "build"

    pushd "build" > /dev/null

    # install the each built arch somewhere sane
    INSTALL_PREFIX="${LIB_PATH}/${SDKNAME}-${ARCH}.sdk"

    mkdir -p "${INSTALL_PREFIX}"

    LOG="${INSTALL_PREFIX}/build-libgit2.log"
    echo "$LOG"

    # Make pkg-config (required by libgit2's cmake to find libssh2) findable
    # in Xcode's restricted build environment, and point it ONLY at the
    # libssh2 built by update_libssh2 -- that's the library the framework
    # links, so its headers are the ones libgit2 must compile against
    # (never a Homebrew libssh2 of some other version).
    #
    # pkg-config can't express paths containing spaces ("Repo Man"), and the
    # .pc that libssh2 installs requires a libcrypto package OpenSSL's
    # build_libs doesn't produce -- either makes libgit2 silently build
    # WITHOUT SSH. So stage headers + static libs in a space-free temp prefix
    # with a minimal libssh2.pc of our own.
    BREW_BIN="$(brew --prefix 2>/dev/null)/bin"
    LIBSSH2_LOCAL="${ROOT_PATH}/External/libssh2-mac/bin/${SDKNAME}-${ARCH}.sdk"
    OPENSSL_LOCAL="${ROOT_PATH}/External/openssl-mac/bin/${SDKNAME}-${ARCH}.sdk"
    SSH2_STAGE="/tmp/libgit2-mac-libssh2-${ARCH}"
    rm -rf "${SSH2_STAGE}"
    mkdir -p "${SSH2_STAGE}/lib/pkgconfig" "${SSH2_STAGE}/include"
    cp -R "${LIBSSH2_LOCAL}/include/." "${SSH2_STAGE}/include/"
    cp "${LIBSSH2_LOCAL}/lib/libssh2.a" "${OPENSSL_LOCAL}/lib/libcrypto.a" "${OPENSSL_LOCAL}/lib/libssl.a" "${SSH2_STAGE}/lib/"
    cat > "${SSH2_STAGE}/lib/pkgconfig/libssh2.pc" <<PC
prefix=${SSH2_STAGE}
libdir=\${prefix}/lib
includedir=\${prefix}/include

Name: libssh2
Description: libssh2 built by SwiftGit2/script/update_libssh2
Version: 1.11
Libs: -L\${libdir} -lssh2 -lcrypto
Cflags: -I\${includedir}
PC
    SSH2_PREFIX_PATH="${SSH2_STAGE}"
    export PKG_CONFIG_PATH="${SSH2_STAGE}/lib/pkgconfig"
    export PKG_CONFIG_LIBDIR="${SSH2_STAGE}/lib/pkgconfig"
    export PATH="${BREW_BIN}:${PATH}"

    # Pre-cache HAVE_LIBSSH2_MEMORY_CREDENTIALS so cmake skips the cross-arch
    # link test (which fails when building x86_64 on Apple Silicon).
    # libssh2 >= 1.9 always has libssh2_userauth_publickey_frommemory.
    MACOSX_DEPLOYMENT_TARGET="10.9" cmake \
        -DBUILD_SHARED_LIBS:BOOL=OFF \
        -DCMAKE_PREFIX_PATH:PATH="${SSH2_PREFIX_PATH}" \
        -DCMAKE_INSTALL_PREFIX:PATH="${INSTALL_PREFIX}/" \
        -DBUILD_CLAR:BOOL=OFF \
        -DTHREADSAFE:BOOL=ON \
        -DCMAKE_OSX_ARCHITECTURES:STRING="${ARCH}" \
        -DHAVE_LIBSSH2_MEMORY_CREDENTIALS:BOOL=ON \
        -DUSE_HTTPS:STRING=SecureTransport \
        -DUSE_SHA1:STRING=CollisionDetection \
        .. >> "${LOG}" 2>&1
    cmake --build . --target install >> "${LOG}" 2>&1
    rm -rf "${SSH2_STAGE}"

    # Refuse to produce a libgit2 without SSH: every git@ remote would fail.
    # (Generated config lives in the build dir, the current directory.)
    if ! grep -q "GIT_SSH 1" src/git2/sys/features.h || \
       ! grep -q "GIT_SSH_MEMORY_CREDENTIALS 1" src/git2/sys/features.h; then
        echo "error: libgit2 was configured without SSH / in-memory key support (see ${LOG})" >&2
        exit 1
    fi

    # push the built library into the list
    BUILT_LIB_PATHS+=("${INSTALL_PREFIX}/lib/libgit2.a")
    popd > /dev/null
}

function fat_binary ()
{
    echo "Building fat binary..."

    lipo -create "${BUILT_LIB_PATHS[@]}" -output "${ROOT_PATH}/External/libgit2-mac/libgit2-mac.a"
    echo "${WANTED}" > "${STAMP}"

    echo "Building done."

    popd > /dev/null
}

# build_libgit2 points cmake at External/libssh2-mac/bin/<sdk>-<arch>.sdk for
# libssh2. Those prefixes are produced by update_libssh2, which runs on the
# SwiftGit2-OSX target -- and this script runs on libgit2-OSX, a dependency of
# it, so it goes first. On a clean checkout the prefix would not exist yet and
# libgit2 would silently be configured without SSH support. Both scripts are
# no-ops once the universal libraries are in place.
"${SCRIPT_DIR}/update_libssl"
"${SCRIPT_DIR}/update_libssh2"

build_all_archs setup build_libgit2 fat_binary

echo "libgit2 has been updated."

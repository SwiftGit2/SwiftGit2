#!/bin/bash

set -e

SCRIPT_DIR=$(dirname "$0")
source "${SCRIPT_DIR}/xcode_functions.sh"

if [[ $(uname -m) == 'arm64' ]]; then
    PATH="/opt/homebrew/bin:$PATH"
else
    PATH="/usr/local/bin:$PATH"
fi

pushd "$SCRIPT_DIR/.." > /dev/null
ROOT_PATH="$PWD"
popd > /dev/null

CLANG="/usr/bin/xcrun clang"

XCODE_MAJOR_VERSION=$(xcode_major_version)
XCODE_MINOR_VERSION=$(xcode_minor_version)

CAN_BUILD_ARM="0"
if [ "${XCODE_MAJOR_VERSION}" -ge "13" ]; then
    CAN_BUILD_ARM="1"
elif [ "${XCODE_MAJOR_VERSION}" -eq "12" ] && [ "${XCODE_MINOR_VERSION}" -ge "2" ]; then
    CAN_BUILD_ARM="1"
fi

ARCHS="x86_64"
if [ "${CAN_BUILD_ARM}" -eq "1" ]; then
    ARCHS="${ARCHS} arm64 arm64e"
fi

LIBRARY_NAME="OpenSSL"
LIB_PATH="${ROOT_PATH}/External/openssl-mac"
STAMP="${LIB_PATH}/BUILT_FROM"
WANTED="openssl $(source_rev "${ROOT_PATH}/External/openssl") archs:${ARCHS} min:${NATIVE_DEPLOYMENT_TARGET}"

# Skip if the universal libraries were already built from this exact source.
if [ -f "${ROOT_PATH}/External/libssl.a" ] && \
   [ -f "${ROOT_PATH}/External/libcrypto.a" ] && \
   [ "$(cat "${STAMP}" 2>/dev/null)" == "${WANTED}" ]
then
    echo "No update needed."
    exit 0
fi

rm -rf "${LIB_PATH}"
mkdir -p "${LIB_PATH}"

PLATFORM="macosx"
SDKVERSION=$(macos_sdk_version)
SDKNAME="${PLATFORM}${SDKVERSION}"
SDKROOT="$(sdk_path ${SDKNAME})"

BUILT_CRYPTO_PATHS=()
BUILT_SSL_PATHS=()

for ARCH in ${ARCHS}; do
    echo "Building ${LIBRARY_NAME} for ${SDKNAME} ${ARCH}"
    echo "Please stand by..."

    INSTALL_PREFIX="${LIB_PATH}/bin/${SDKNAME}-${ARCH}.sdk"
    mkdir -p "${INSTALL_PREFIX}"
    LOG="${INSTALL_PREFIX}/build-openssl.log"
    echo "${LOG}"

    # Build in a space-free temp path ("Repo Man" in the checkout path breaks
    # OpenSSL's Makefiles).
    TMP_BUILD="/tmp/openssl-mac-build-${ARCH}"
    TMP_INSTALL="/tmp/openssl-mac-install-${ARCH}"

    rm -rf "${TMP_BUILD}" "${TMP_INSTALL}"
    cp -R "${ROOT_PATH}/External/openssl" "${TMP_BUILD}"
    pushd "${TMP_BUILD}" > /dev/null

    if [ "${ARCH}" == "x86_64" ]; then
        TARGET="darwin64-x86_64-cc"
    else
        # arm64e uses the arm64 target, retargeted below.
        TARGET="darwin64-arm64-cc"
    fi

    # Static libcrypto/libssl only (consumed by libssh2). no-asm keeps the
    # cross-arch builds (x86_64 / arm64e on an arm64 host) simple and safe.
    CC="${CLANG} -arch ${ARCH} -isysroot ${SDKROOT} -mmacosx-version-min=${NATIVE_DEPLOYMENT_TARGET}" \
    ./Configure "${TARGET}" \
        no-shared no-module no-engine no-asm no-tests no-docs no-apps \
        --prefix="${TMP_INSTALL}" \
        --openssldir="${TMP_INSTALL}/ssl" \
        --libdir=lib >> "${LOG}" 2>&1

    # darwin64-arm64-cc hardcodes "-arch arm64" in its flags; retarget the
    # generated Makefile so the arm64e slice really is arm64e.
    if [ "${ARCH}" == "arm64e" ]; then
        perl -i -pe 's/-arch arm64(?![e\w])/-arch arm64e/g' Makefile
    fi

    # build_libs stops after libcrypto/libssl.
    make -j"$(sysctl -n hw.ncpu)" build_libs >> "${LOG}" 2>&1

    mkdir -p "${INSTALL_PREFIX}/lib" "${INSTALL_PREFIX}/include"
    cp libcrypto.a libssl.a "${INSTALL_PREFIX}/lib/"
    # libssh2 configures against this prefix (OPENSSL_ROOT_DIR).
    cp -RL include/openssl "${INSTALL_PREFIX}/include/"

    popd > /dev/null
    rm -rf "${TMP_BUILD}" "${TMP_INSTALL}"

    BUILT_CRYPTO_PATHS+=("${INSTALL_PREFIX}/lib/libcrypto.a")
    BUILT_SSL_PATHS+=("${INSTALL_PREFIX}/lib/libssl.a")
done

echo "Building fat binaries..."
lipo -create "${BUILT_CRYPTO_PATHS[@]}" -output "${ROOT_PATH}/External/libcrypto.a"
lipo -create "${BUILT_SSL_PATHS[@]}" -output "${ROOT_PATH}/External/libssl.a"
echo "${WANTED}" > "${STAMP}"

echo "OpenSSL has been updated."
